<Window x:Class="ExamBro.Config.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masuk Administrator - ExamBro"
        Width="440"
        MinHeight="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo & Title Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🛡" FontSize="28" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="ExamBro Configurator"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Panel Pengaturan Administrator"
                           FontSize="12"
                           Foreground="#475569"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Input Area -->
            <StackPanel Grid.Row="1" Margin="0,0,0,18">
                <Label Target="{Binding ElementName=TxtPassword}"
                       Content="Password Administrator:"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Padding="0"
                       Margin="0,0,0,6"/>

                <Border Style="{StaticResource ConfigPasswordFieldBorderStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="TxtPassword"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     CaretBrush="#0F172A"
                                     Padding="10,0,4,0"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Password administrator"/>

                        <TextBox x:Name="TxtPasswordVisible"
                                 Grid.Column="0"
                                 Style="{x:Null}"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 Padding="10,0,4,0"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="Password administrator (terlihat)"/>

                        <ToggleButton x:Name="BtnTogglePassword"
                                      Grid.Column="1"
                                      Style="{StaticResource ConfigPasswordRevealToggleStyle}"/>
                    </Grid>
                </Border>

                <TextBlock x:Name="TxtAttemptsInfo"
                           Text="Batas percobaan: 5 kali"
                           FontSize="11.5"
                           Foreground="#475569"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="TxtError"
                           Foreground="#B91C1C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="TxtLockoutMessage"
                           Foreground="#9A3412"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="2" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Batal / Keluar"
                        Grid.Column="0"
                        Height="38"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,6,0"
                        FocusVisualStyle="{StaticResource ConfigFocusVisualStyle}"
                        Click="BtnCancel_Click"/>

                <Button x:Name="BtnLogin"
                        Content="Masuk"
                        Grid.Column="1"
                        Height="38"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Margin="6,0,0,0"
                        FocusVisualStyle="{StaticResource ConfigFocusVisualStyle}"
                        Click="BtnLogin_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
