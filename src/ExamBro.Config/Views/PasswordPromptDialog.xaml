<Window x:Class="ExamBro.Config.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masukkan Password"
        Width="420"
        MinHeight="240"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       Text="Masukkan Password"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       Margin="0,0,0,8"/>

            <TextBlock x:Name="PromptMessageText"
                       Text="Masukkan password konfigurasi:"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       Margin="0,0,0,14"/>

            <Label Target="{Binding ElementName=TxtPassword}"
                   Content="Password:"
                   FontWeight="SemiBold"
                   Foreground="#1E293B"
                   Padding="0"
                   Margin="0,0,0,4"/>

            <Border Style="{StaticResource ConfigPasswordFieldBorderStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="TxtPassword"
                                 Grid.Column="0"
                                 Style="{x:Null}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 Padding="10,0,4,0"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="Password"/>

                    <TextBox x:Name="TxtPasswordVisible"
                             Grid.Column="0"
                             Style="{x:Null}"
                             Visibility="Collapsed"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="14"
                             Foreground="#0F172A"
                             CaretBrush="#0F172A"
                             Padding="10,0,4,0"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             AutomationProperties.Name="Password (terlihat)"/>

                    <ToggleButton x:Name="BtnTogglePassword"
                                  Grid.Column="1"
                                  Style="{StaticResource ConfigPasswordRevealToggleStyle}"/>
                </Grid>
            </Border>

            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,2,0,10">
                <Label Target="{Binding ElementName=TxtConfirmPassword}"
                       Content="Konfirmasi Password:"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Padding="0"
                       Margin="0,0,0,4"/>

                <Border Style="{StaticResource ConfigPasswordFieldBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <PasswordBox x:Name="TxtConfirmPassword"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     CaretBrush="#0F172A"
                                     Padding="10,0,4,0"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Konfirmasi password"/>

                        <TextBox x:Name="TxtConfirmPasswordVisible"
                                 Grid.Column="0"
                                 Style="{x:Null}"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 Padding="10,0,4,0"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="Konfirmasi password (terlihat)"/>

                        <ToggleButton x:Name="BtnToggleConfirmPassword"
                                      Grid.Column="1"
                                      Style="{StaticResource ConfigPasswordRevealToggleStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock x:Name="TxtError"
                       Foreground="#B91C1C"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       AutomationProperties.LiveSetting="Assertive"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Batal"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="88"
                        Height="36"
                        Margin="0,0,10,0"
                        FocusVisualStyle="{StaticResource ConfigFocusVisualStyle}"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk"
                        Content="OK"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="88"
                        Height="36"
                        FocusVisualStyle="{StaticResource ConfigFocusVisualStyle}"
                        Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
