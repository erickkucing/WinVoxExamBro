<Window x:Class="ExamBro.Config.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Masukkan Password"
        Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="20">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" 
                       Text="Masukkan Password" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryBrush}" 
                       Margin="0,0,0,8"/>
            
            <TextBlock x:Name="PromptMessageText" 
                       Text="Masukkan password konfigurasi:" 
                       TextWrapping="Wrap" 
                       Foreground="{StaticResource TextBrush}" 
                       Margin="0,0,0,12"/>

            <TextBlock Text="Password:" Margin="0,0,0,2"/>
            <PasswordBox x:Name="TxtPassword" 
                         Height="30" 
                         Margin="0,0,0,8" 
                         PasswordChanged="TxtPassword_PasswordChanged"/>

            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock Text="Konfirmasi Password:" Margin="0,0,0,2"/>
                <PasswordBox x:Name="TxtConfirmPassword" 
                             Height="30" 
                             Margin="0,0,0,8"/>
            </StackPanel>

            <TextBlock x:Name="TxtError" 
                       Foreground="{StaticResource ErrorBrush}" 
                       FontSize="12" 
                       TextWrapping="Wrap" 
                       Margin="0,0,0,8" 
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Batal" 
                        Style="{StaticResource SecondaryButton}" 
                        Width="80" 
                        Margin="0,0,10,0" 
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" 
                        Content="OK" 
                        Style="{StaticResource PrimaryButton}" 
                        Width="80" 
                        Click="BtnOk_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
