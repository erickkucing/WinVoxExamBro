<Window x:Class="ExamBro.Config.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ganti Password"
        Height="440" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitle" 
                           Text="Ganti Password" 
                           FontSize="18" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Masukkan password saat ini dan tentukan password baru dengan minimal 6 karakter." 
                           TextWrapping="Wrap" 
                           FontSize="12" 
                           Foreground="{StaticResource SecondaryTextBrush}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="2">
                <!-- Current Password -->
                <StackPanel x:Name="CurrentPasswordPanel" Margin="0,0,0,8">
                    <TextBlock Text="Password Saat Ini:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="TxtCurrentPassword" Height="30"/>
                </StackPanel>

                <!-- New Password -->
                <TextBlock Text="Password Baru:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <PasswordBox x:Name="TxtNewPassword" Height="30" PasswordChanged="TxtNewPassword_PasswordChanged"/>

                <!-- Strength Indicator -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ProgressStrength" Height="6" Maximum="4" Value="0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStrengthLabel" Grid.Column="1" Text="Kekuatan: -" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                </Grid>

                <!-- Confirm Password -->
                <TextBlock Text="Konfirmasi Password Baru:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                <PasswordBox x:Name="TxtConfirmPassword" Height="30" Margin="0,0,0,8"/>

                <!-- Error Message -->
                <TextBlock x:Name="TxtError" 
                           Foreground="{StaticResource ErrorBrush}" 
                           FontSize="12" 
                           TextWrapping="Wrap" 
                           Margin="0,4,0,8" 
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Batal" 
                        Style="{StaticResource SecondaryButton}" 
                        Width="90" 
                        Margin="0,0,10,0" 
                        Click="BtnCancel_Click"/>
                <Button Content="Simpan Password" 
                        Style="{StaticResource PrimaryButton}" 
                        Padding="14,6" 
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
