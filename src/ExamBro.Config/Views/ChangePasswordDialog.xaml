<Window x:Class="ExamBro.Config.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ganti Password"
        Width="450"
        MinHeight="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TxtTitle"
                           Text="Ganti Password"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Text="Masukkan password saat ini dan tentukan password baru dengan minimal 6 karakter."
                           TextWrapping="Wrap"
                           FontSize="12.5"
                           Foreground="#475569"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <!-- Current Password -->
                <StackPanel x:Name="CurrentPasswordPanel" Margin="0,0,0,10">
                    <Label Target="{Binding ElementName=TxtCurrentPassword}"
                           Content="Password Saat Ini:"
                           FontWeight="SemiBold"
                           Foreground="#1E293B"
                           Padding="0"
                           Margin="0,0,0,4"/>
                    <Border Style="{StaticResource ConfigPasswordFieldBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtCurrentPassword"
                                         Grid.Column="0"
                                         Style="{x:Null}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontSize="14"
                                         Foreground="#0F172A"
                                         CaretBrush="#0F172A"
                                         Padding="10,0,4,0"
                                         VerticalAlignment="Stretch"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Left"
                                         AutomationProperties.Name="Password saat ini"/>
                            <TextBox x:Name="TxtCurrentPasswordVisible"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Visibility="Collapsed"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     CaretBrush="#0F172A"
                                     Padding="10,0,4,0"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Password saat ini (terlihat)"/>
                            <ToggleButton x:Name="BtnToggleCurrentPassword"
                                          Grid.Column="1"
                                          Style="{StaticResource ConfigPasswordRevealToggleStyle}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- New Password -->
                <Label Target="{Binding ElementName=TxtNewPassword}"
                       Content="Password Baru:"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Padding="0"
                       Margin="0,0,0,4"/>
                <Border Style="{StaticResource ConfigPasswordFieldBorderStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtNewPassword"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     CaretBrush="#0F172A"
                                     Padding="10,0,4,0"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Password baru"/>
                        <TextBox x:Name="TxtNewPasswordVisible"
                                 Grid.Column="0"
                                 Style="{x:Null}"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 Padding="10,0,4,0"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="Password baru (terlihat)"/>
                        <ToggleButton x:Name="BtnToggleNewPassword"
                                      Grid.Column="1"
                                      Style="{StaticResource ConfigPasswordRevealToggleStyle}"/>
                    </Grid>
                </Border>

                <!-- Strength Indicator -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ProgressStrength" Height="6" Maximum="4" Value="0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtStrengthLabel" Grid.Column="1" Text="Kekuatan: -" FontSize="11.5" Foreground="#475569"/>
                </Grid>

                <!-- Confirm Password -->
                <Label Target="{Binding ElementName=TxtConfirmPassword}"
                       Content="Konfirmasi Password Baru:"
                       FontWeight="SemiBold"
                       Foreground="#1E293B"
                       Padding="0"
                       Margin="0,0,0,4"/>
                <Border Style="{StaticResource ConfigPasswordFieldBorderStyle}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="TxtConfirmPassword"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="14"
                                     Foreground="#0F172A"
                                     CaretBrush="#0F172A"
                                     Padding="10,0,4,0"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     AutomationProperties.Name="Konfirmasi password baru"/>
                        <TextBox x:Name="TxtConfirmPasswordVisible"
                                 Grid.Column="0"
                                 Style="{x:Null}"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="14"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 Padding="10,0,4,0"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="Konfirmasi password baru (terlihat)"/>
                        <ToggleButton x:Name="BtnToggleConfirmPassword"
                                      Grid.Column="1"
                                      Style="{StaticResource ConfigPasswordRevealToggleStyle}"/>
                    </Grid>
                </Border>

                <!-- Error Message -->
                <TextBlock x:Name="TxtError"
                           Foreground="#B91C1C"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"
                           AutomationProperties.LiveSetting="Assertive"
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Batal"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButton}"
                        MinWidth="92"
                        Height="36"
                        Margin="0,0,10,0"
                        FocusVisualStyle="{StaticResource ConfigFocusVisualStyle}"
                        Click="BtnCancel_Click"/>
                <Button Content="Simpan Password"
                        IsDefault="True"
                        Style="{StaticResource PrimaryButton}"
                        Height="36"
                        Padding="16,6"
                        FocusVisualStyle="{StaticResource ConfigFocusVisualStyle}"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
