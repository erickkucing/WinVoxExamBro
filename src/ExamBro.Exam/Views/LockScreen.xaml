<UserControl x:Class="ExamBro.Exam.Views.LockScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0E14"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid>
        <Border Width="520"
                Background="#161B22"
                CornerRadius="16"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#B71C1C"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#D32F2F" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" Background="#2C0B0E" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="38" Foreground="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="UJIAN TERKUNCI"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF5252"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="txtReason"
                           Text="Aplikasi terkunci karena terdeteksi pelanggaran berulang kali."
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#B0BEC5"
                           Margin="0,0,0,24"/>
                
                <TextBlock Text="Kata Sandi Pengawas (Proctor):"
                           FontSize="13"
                           Foreground="#90A4AE"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="pwdProctor"
                             Height="42"
                             FontSize="16"
                             Padding="10,6"
                             Background="#0D1117"
                             Foreground="#FFFFFF"
                             BorderBrush="#30363D"
                             BorderThickness="1"
                             KeyDown="PwdProctor_KeyDown"/>
                
                <TextBlock x:Name="txtError"
                           Text=""
                           FontSize="13"
                           Foreground="#FF5252"
                           TextAlignment="Center"
                           Margin="0,10,0,10"
                           Visibility="Collapsed"/>
                
                <Button x:Name="btnUnlock"
                        Content="Buka Kunci Ujian"
                        Height="42"
                        Margin="0,12,0,0"
                        Background="#B71C1C"
                        Foreground="#FFFFFF"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnUnlock_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock x:Name="txtLockoutTimer"
                           Text=""
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="#FFA726"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
