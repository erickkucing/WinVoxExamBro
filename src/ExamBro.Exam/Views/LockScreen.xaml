<UserControl x:Class="ExamBro.Exam.Views.LockScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0E14"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Border Width="520"
                Background="#161B22"
                CornerRadius="16"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#B71C1C"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#D32F2F" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Stretch">
                <Border Width="72" Height="72" CornerRadius="36" Background="#2C0B0E" Margin="0,0,0,18" HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="38" Foreground="#FF5252" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="UJIAN TERKUNCI"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FF5252"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="txtReason"
                           Text="Aplikasi terkunci karena terdeteksi pelanggaran berulang kali."
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Kata Sandi Pengawas (Proctor):"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#CBD5E1"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="pwdProctor"
                             AutomationProperties.Name="Kata Sandi Pengawas LockScreen"
                             Height="44"
                             FontSize="16"
                             FontFamily="Segoe UI"
                             Padding="14,0"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             Background="#0D1117"
                             Foreground="#FFFFFF"
                             CaretBrush="#F8FAFC"
                             SelectionBrush="#1D4ED8"
                             BorderBrush="#6E7681"
                             BorderThickness="1.5"
                             KeyDown="PwdProctor_KeyDown">
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="0"
                                              Padding="0"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="Stretch"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              Focusable="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#60A5FA"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>

                <TextBlock x:Name="txtError"
                           Text=""
                           FontSize="13"
                           Foreground="#FCA5A5"
                           TextAlignment="Center"
                           Margin="0,10,0,10"
                           Visibility="Collapsed"/>

                <Button x:Name="btnUnlock"
                        Content="Buka Kunci Ujian"
                        Height="44"
                        Margin="0,14,0,0"
                        Background="#B71C1C"
                        Foreground="#FFFFFF"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnUnlock_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#DC2626"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FCA5A5"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.55"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock x:Name="txtLockoutTimer"
                           Text=""
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="#FCD34D"
                           TextAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
