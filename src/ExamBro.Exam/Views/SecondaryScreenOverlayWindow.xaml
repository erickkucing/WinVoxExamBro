<Window x:Class="ExamBro.Exam.Views.SecondaryScreenOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ExamBro - Secondary Monitor"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#121212">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="80" Height="80" CornerRadius="40" Background="#263238" Margin="0,0,0,24">
                <TextBlock Text="✕" FontSize="44" Foreground="#D32F2F" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
            </Border>
            <TextBlock Text="Layar Sekunder Dinonaktifkan"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>
            <TextBlock Text="Penggunaan beberapa layar tidak diperbolehkan selama ujian berlangsung."
                       FontSize="15"
                       Foreground="#9E9E9E"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
