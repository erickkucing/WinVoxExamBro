<UserControl x:Class="ExamBro.Exam.Views.CompletionOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E60F172A"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Border Width="500"
                Background="#FFFFFF"
                CornerRadius="16"
                Padding="40"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="80" Height="80" CornerRadius="40" Background="#E8F5E9" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="44" Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Border>
                <TextBlock Text="UJIAN SELESAI"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1B5E20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Terima kasih telah mengikuti ujian dengan tertib. Jawaban Anda telah tersimpan."
                           FontSize="15"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#334155"
                           Margin="0,0,0,20"/>

                <TextBlock x:Name="txtCountdown"
                           Text="Ujian telah selesai. Aplikasi terkunci dan hanya dapat ditutup oleh pengawas dengan password."
                           FontSize="14"
                           FontStyle="Italic"
                           Foreground="#475569"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <Button x:Name="btnExitNow"
                        Content="Keluar (Pengawas)"
                        Width="210"
                        Height="44"
                        Background="#2E7D32"
                        Foreground="#FFFFFF"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnExitNow_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#1B5E20"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#14532D"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#86EFAC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
