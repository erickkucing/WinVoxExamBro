<Window x:Class="ExamBro.Exam.Views.ExamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:ExamBro.Exam.Views"
        Title="ExamBro - Ujian Online"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        WindowState="Maximized"
        ShowInTaskbar="False"
        Background="#000000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ECEFF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37474F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#263238"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#546E7A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Main Application Shell -->
        <DockPanel LastChildFill="True">
            <!-- Toolbar (Docked Top) -->
            <Border DockPanel.Dock="Top"
                    Height="44"
                    Background="#1E293B"
                    BorderBrush="#334155"
                    BorderThickness="0,0,0,1"
                    Padding="12,0"
                    Visibility="{Binding IsToolbarVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Left Navigation Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Content="◀"
                                ToolTip="Kembali"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding GoBackCommand}"
                                IsEnabled="{Binding CanGoBack}"/>
                        <Button Content="▶"
                                ToolTip="Maju"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding GoForwardCommand}"
                                IsEnabled="{Binding CanGoForward}"/>
                        <Button Content="↻"
                                ToolTip="Muat Ulang"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding ReloadCommand}"/>
                        <Button Content="⌂"
                                ToolTip="Halaman Awal"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding GoHomeCommand}"/>

                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="8,4" Background="#475569"/>

                        <!-- Current Domain Info -->
                        <Border Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒 " Foreground="#22C55E" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentDomain}"
                                           Foreground="#CBD5E1"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center Title & User Info -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}"
                                   Foreground="#F8FAFC"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" • " Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="6,0"/>
                        <TextBlock Text="{Binding UserInfo}"
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Status & Exit Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Network Status Indicator -->
                        <Border Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📶 " Foreground="#38BDF8" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NetworkStatus}"
                                           Foreground="#94A3B8"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Digital Clock -->
                        <Border Background="#0F172A" CornerRadius="4" Padding="8,4" Margin="0,0,12,0">
                            <TextBlock Text="{Binding ClockTime}"
                                       Foreground="#F8FAFC"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       FontFamily="Consolas"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Exit Button -->
                        <Button Content="Keluar"
                                Height="28"
                                Padding="14,0"
                                Background="#DC2626"
                                Foreground="#FFFFFF"
                                FontSize="12"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding RequestExitCommand}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Embedded WebView2 Browser -->
            <wv2:WebView2 x:Name="webView"/>
        </DockPanel>

        <!-- Security Warning Overlay (Auto-dismisses in 5s) -->
        <views:WarningOverlay x:Name="warningOverlay" Visibility="Collapsed"/>

        <!-- Lockout Overlay (Requires Proctor Unlock) -->
        <views:LockScreen x:Name="lockScreen" Visibility="Collapsed"/>

        <!-- Completion Overlay (Exam Finish Countdown) -->
        <views:CompletionOverlay x:Name="completionOverlay" Visibility="Collapsed"/>
    </Grid>
</Window>
