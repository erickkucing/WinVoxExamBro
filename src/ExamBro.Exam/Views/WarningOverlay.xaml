<UserControl x:Class="ExamBro.Exam.Views.WarningOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#D90F172A"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Border Width="480"
                Background="#FFFFFF"
                CornerRadius="12"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#F59E0B"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#FFF3E0" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="36" Foreground="#C2410C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PERINGATAN PELANGGARAN"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#B91C1C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="txtMessage"
                           Text="Anda terdeteksi melakukan tindakan yang melanggar ketentuan ujian."
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#334155"
                           Margin="0,0,0,16"/>
                <TextBlock x:Name="txtCountdown"
                           Text="Peringatan ini akan ditutup otomatis dalam 5 detik."
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="#475569"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button x:Name="btnDismiss"
                        Content="Saya Mengerti"
                        Width="190"
                        Height="44"
                        Background="#C2410C"
                        Foreground="#FFFFFF"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnDismiss_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent"
                                    BorderThickness="2"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#9A3412"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#7C2D12"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#FDE68A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
