<UserControl x:Class="ExamBro.Exam.Views.WarningOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#B3000000"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <Grid>
        <Border Width="480"
                Background="#FFFFFF"
                CornerRadius="12"
                Padding="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="#FFB74D"
                BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="32" Background="#FFF3E0" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="36" Foreground="#E65100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PERINGATAN PELANGGARAN"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#D84315"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock x:Name="txtMessage"
                           Text="Anda terdeteksi melakukan tindakan yang melanggar ketentuan ujian."
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Foreground="#37474F"
                           Margin="0,0,0,16"/>
                <TextBlock x:Name="txtCountdown"
                           Text="Peringatan ini akan ditutup otomatis dalam 5 detik."
                           FontSize="13"
                           FontStyle="Italic"
                           Foreground="#78909C"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button x:Name="btnDismiss"
                        Content="Saya Mengerti"
                        Width="180"
                        Height="40"
                        Background="#E65100"
                        Foreground="#FFFFFF"
                        FontSize="14"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnDismiss_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
