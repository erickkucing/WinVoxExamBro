<Window x:Class="ExamBro.Exam.Views.PreFlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pemeriksaan Kesiapan Sistem - ExamBro"
        Width="600"
        Height="540"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        BorderBrush="#CFD8DC"
        Background="#F8FAFC"
        Topmost="True">
    <Window.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
    </Window.Effect>
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Pemeriksaan Kesiapan Sistem"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1E293B"/>
            <TextBlock Text="Memverifikasi keamanan perangkat sebelum memulai ujian..."
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Checks List -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
            <ItemsControl x:Name="icChecks">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="8,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Status Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{Binding IconColor}"
                                           VerticalAlignment="Center"/>
                                <!-- Title and Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#334155"/>
                                    <TextBlock Text="{Binding Details}"
                                               FontSize="11"
                                               Foreground="{Binding DetailsColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                                <!-- Status Text -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding StatusText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding IconColor}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <TextBlock x:Name="txtOverallStatus"
                       Text="Memeriksa sistem..."
                       FontSize="13"
                       FontWeight="Medium"
                       Foreground="#64748B"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnClose"
                        Content="Tutup Aplikasi"
                        Width="120"
                        Height="38"
                        Margin="0,0,12,0"
                        Background="#EF4444"
                        Foreground="#FFFFFF"
                        FontSize="13"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnClose_Click"
                        Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btnStart"
                        Content="Mulai Ujian"
                        Width="130"
                        Height="38"
                        Background="#2563EB"
                        Foreground="#FFFFFF"
                        FontSize="13"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        IsEnabled="False"
                        Click="BtnStart_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
