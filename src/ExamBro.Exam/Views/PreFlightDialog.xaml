<Window x:Class="ExamBro.Exam.Views.PreFlightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pemeriksaan Kesiapan Sistem - LouisVox ExamBro"
        Width="720"
        MinHeight="580"
        MaxHeight="720"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        BorderBrush="#CBD5E1"
        Background="#F8FAFC"
        Topmost="True">
    <Window.Effect>
        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.25" Color="#000000"/>
    </Window.Effect>

    <Window.Resources>
        <!-- Button Styles for Clean Professional UX -->
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#991B1B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#F87171"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                                <Setter Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineAccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#94A3B8"/>
                                <Setter Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <!-- 0: Header -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Checks List (Scrollable) -->
            <RowDefinition Height="*"/>
            <!-- 2: Status Alert Banner -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Action Buttons Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="tbTitle"
                           Text="Pemeriksaan Sistem - LouisVox ExamBro"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="Memverifikasi keamanan dan integritas perangkat sebelum memulai ujian..."
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Width="52" Height="52" CornerRadius="8" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="4" VerticalAlignment="Center">
                <Image x:Name="imgLogo" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>

        <!-- Checks List -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="icChecks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="6,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Status Icon -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Icon}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="{Binding IconColor}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <!-- Title and Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"/>
                                        <TextBlock Text="{Binding Details}"
                                                   FontSize="11.5"
                                                   Foreground="{Binding DetailsColor}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <!-- Status Pill Badge -->
                                    <Border Grid.Column="2"
                                            Background="{Binding StatusBadgeBg}"
                                            BorderBrush="{Binding StatusBadgeBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="10,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBadgeFg}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status Alert Banner (Full Width, Dedicated Zone) -->
        <Border x:Name="pnlAlertBanner"
                Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtAlertIcon"
                           Text="⏳"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="txtOverallStatus"
                           Grid.Column="1"
                           Text="Memeriksa sistem perangkat..."
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <!-- Action Buttons Footer (Clear 2-Sided Alignment) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cancel & Prohibited Process Cleanup Actions (Left) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btnClose"
                        Content="Tutup Aplikasi"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="40"
                        MinWidth="120"
                        IsCancel="True"
                        ToolTip="Keluar dari aplikasi ujian (Esc)"
                        Click="BtnClose_Click"/>
                <Button x:Name="btnKillOffending"
                        Content="⚡ Tutup Aplikasi Terlarang"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="40"
                        MinWidth="180"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        ToolTip="Tutup paksa seluruh aplikasi terlarang yang sedang aktif"
                        Click="BtnKillOffending_Click"/>
                <Button x:Name="btnElevateAdmin"
                        Content="🛡 Jalankan sebagai Admin"
                        Style="{StaticResource DangerButtonStyle}"
                        Height="40"
                        MinWidth="180"
                        Margin="10,0,0,0"
                        Visibility="Collapsed"
                        ToolTip="Buka kembali aplikasi dengan hak akses Administrator penuh"
                        Click="BtnElevateAdmin_Click"/>
            </StackPanel>

            <!-- Confirmation & Retry Actions (Right) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnRetry"
                        Content="⟳  Periksa Ulang"
                        Style="{StaticResource OutlineAccentButtonStyle}"
                        Height="40"
                        MinWidth="130"
                        Margin="0,0,12,0"
                        ToolTip="Pindai ulang sistem setelah menutup aplikasi atau menyesuaikan pengaturan"
                        Click="BtnRetry_Click"/>
                <Button x:Name="btnStart"
                        Content="Mulai Ujian  ➔"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Height="40"
                        MinWidth="135"
                        IsEnabled="False"
                        IsDefault="True"
                        ToolTip="Mulai sesi ujian dan masuki mode kiosk aman (Enter)"
                        Click="BtnStart_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
