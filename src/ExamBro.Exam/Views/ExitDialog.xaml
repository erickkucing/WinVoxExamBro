<Window x:Class="ExamBro.Exam.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfirmasi Keluar Ujian"
        Width="440"
        Height="360"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        BorderBrush="#CFD8DC"
        Background="#FFFFFF"
        Topmost="True">
    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
    </Window.Effect>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Konfirmasi Keluar Ujian"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#263238"/>
            <TextBlock Text="Masukkan kata sandi pengawas untuk mengakhiri sesi ujian ini."
                       FontSize="13"
                       Foreground="#78909C"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Input Area -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Kata Sandi Pengawas:"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#37474F"
                       Margin="0,0,0,6"/>
            <PasswordBox x:Name="pwdExit"
                         Height="38"
                         FontSize="15"
                         Padding="8,4"
                         BorderBrush="#B0BEC5"
                         BorderThickness="1"
                         KeyDown="PwdExit_KeyDown"/>
            <TextBlock x:Name="txtError"
                       Text=""
                       FontSize="12"
                       Foreground="#D32F2F"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="txtLockout"
                       Text=""
                       FontSize="12"
                       FontStyle="Italic"
                       Foreground="#E65100"
                       Margin="0,6,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Spacer -->
        <Grid Grid.Row="2"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel"
                    Content="Batal"
                    Width="100"
                    Height="36"
                    Margin="0,0,12,0"
                    Background="#ECEFF1"
                    Foreground="#37474F"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnCancel_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="btnConfirmExit"
                    Content="Keluar Ujian"
                    Width="120"
                    Height="36"
                    Background="#D32F2F"
                    Foreground="#FFFFFF"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnConfirmExit_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
