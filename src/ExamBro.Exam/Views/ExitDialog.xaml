<Window x:Class="ExamBro.Exam.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfirmasi Keluar Ujian"
        Width="440"
        MinHeight="240"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        BorderBrush="#CBD5E1"
        Background="#FFFFFF"
        Topmost="True">
    <Window.Effect>
        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2" Color="#000000"/>
    </Window.Effect>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Konfirmasi Keluar Ujian"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock Text="Masukkan kata sandi pengawas atau admin untuk mengakhiri sesi ujian ini."
                       FontSize="13"
                       Foreground="#475569"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Input Area -->
        <StackPanel Grid.Row="1" Margin="0,0,0,22">
            <Label Target="{Binding ElementName=pwdExit}"
                   Content="Kata Sandi Pengawas:"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#1E293B"
                   Padding="0"
                   Margin="0,0,0,6"/>

            <Border Style="{StaticResource PasswordFieldBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <PasswordBox x:Name="pwdExit"
                                 Grid.Column="0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontSize="15"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 Padding="12,0,4,0"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Left"
                                 AutomationProperties.Name="Kata sandi pengawas"/>

                    <TextBox x:Name="txtExitPasswordVisible"
                             Grid.Column="0"
                             Visibility="Collapsed"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="15"
                             Foreground="#0F172A"
                             CaretBrush="#0F172A"
                             Padding="12,0,4,0"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left"
                             AutomationProperties.Name="Kata sandi pengawas (terlihat)"/>

                    <ToggleButton x:Name="btnTogglePassword"
                                  Grid.Column="1"
                                  Style="{StaticResource PasswordRevealToggleStyle}"/>
                </Grid>
            </Border>

            <TextBlock x:Name="txtError"
                       Text=""
                       FontSize="12"
                       Foreground="#B91C1C"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Assertive"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="txtLockout"
                       Text=""
                       FontSize="12"
                       Foreground="#9A3412"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       AutomationProperties.LiveSetting="Assertive"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnCancel"
                    Content="Batal"
                    MinWidth="104"
                    Height="40"
                    Margin="0,0,12,0"
                    IsCancel="True"
                    Background="#F1F5F9"
                    Foreground="#1E293B"
                    BorderBrush="#64748B"
                    BorderThickness="1"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    FocusVisualStyle="{StaticResource ExamFocusVisualStyle}"
                    Click="BtnCancel_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button x:Name="btnConfirmExit"
                    Content="Keluar Ujian"
                    MinWidth="128"
                    Height="40"
                    IsDefault="True"
                    Background="#DC2626"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    FocusVisualStyle="{StaticResource ExamFocusVisualStyle}"
                    Click="BtnConfirmExit_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#991B1B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
