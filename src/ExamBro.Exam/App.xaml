<Application x:Class="ExamBro.Exam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Application-level theme resources and palettes -->
        <SolidColorBrush x:Key="PrimaryColorBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="DangerColorBrush" Color="#D32F2F" />
        <SolidColorBrush x:Key="WarningColorBrush" Color="#ED6C02" />
        <SolidColorBrush x:Key="SuccessColorBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMainBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="TextSubBrush" Color="#475569" />

        <!-- Shared accessible focus ring for keyboard navigation -->
        <Style x:Key="ExamFocusVisualStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3"
                                   RadiusX="6"
                                   RadiusY="6"
                                   Stroke="#2563EB"
                                   StrokeThickness="2"
                                   SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Light theme password container & reveal toggle (WCAG 1.4.11 >=3:1 border contrast) -->
        <Style x:Key="PasswordFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#1D4ED8"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkPasswordFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1117"/>
            <Setter Property="BorderBrush" Value="#6E7681"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#60A5FA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#161B22"/>
                    <Setter Property="BorderBrush" Value="#484F58"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PasswordRevealToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,1,2,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ExamFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="toggleBg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 1.5,8 C 3.3,4.4 5.7,3 8,3 C 10.3,3 12.7,4.4 14.5,8 C 12.7,11.6 10.3,13 8,13 C 5.7,13 3.3,11.6 1.5,8 Z"/>
                                <Ellipse Canvas.Left="5.75" Canvas.Top="5.75" Width="4.5" Height="4.5"
                                         Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
                                <Path x:Name="SlashPath"
                                      Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2.5,13.5 L 13.5,2.5"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleBg" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="toggleBg" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter TargetName="SlashPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkPasswordRevealToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,1,2,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource ExamFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="toggleBg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Canvas Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 1.5,8 C 3.3,4.4 5.7,3 8,3 C 10.3,3 12.7,4.4 14.5,8 C 12.7,11.6 10.3,13 8,13 C 5.7,13 3.3,11.6 1.5,8 Z"/>
                                <Ellipse Canvas.Left="5.75" Canvas.Top="5.75" Width="4.5" Height="4.5"
                                         Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"/>
                                <Path x:Name="SlashPath"
                                      Visibility="Collapsed"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M 2.5,13.5 L 13.5,2.5"/>
                            </Canvas>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleBg" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="toggleBg" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#60A5FA"/>
                                <Setter TargetName="SlashPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
