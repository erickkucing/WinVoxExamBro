<Application x:Class="ExamBro.Exam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Application-level theme resources and palettes -->
        <SolidColorBrush x:Key="PrimaryColorBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="DangerColorBrush" Color="#D32F2F" />
        <SolidColorBrush x:Key="WarningColorBrush" Color="#ED6C02" />
        <SolidColorBrush x:Key="SuccessColorBrush" Color="#2E7D32" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextMainBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="TextSubBrush" Color="#64748B" />
    </Application.Resources>
</Application>
